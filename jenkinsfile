pipeline {
    agent any
    environment {
        VERSION = '1.0'
    }
    stages {
        stage('compile') {
            steps {
                sh 'javac Main.java'
            }
        }
        stage('run') {
            steps {
                sh 'java Main.java'
                sh 'echo "Version: ${VERSION}"'
            }
        }
    }
    post {
        always {
            sh 'echo "This will always run"'
        }
        success {
            sh 'echo "This will run only if successful"'
        }
        failure {
            sh 'echo "This will run only if failed"'
        }
    }
}
